{
  "$defs": {
    "MatchWindow": {
      "additionalProperties": false,
      "description": "A nonempty half-open [from_ms, to_ms) window of match clock time.\n\nWith a period, the window covers that period only. Without one (``None``), it covers\nboth periods: every event whose match clock falls in the window, whichever half it is\nin. That is how a \"whole match so far\" claim is expressed as a single assertion.",
      "properties": {
        "from_ms": {
          "minimum": 0,
          "title": "From Ms",
          "type": "integer"
        },
        "period": {
          "anyOf": [
            {
              "enum": [
                1,
                2
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "to_ms": {
          "minimum": 1,
          "title": "To Ms",
          "type": "integer"
        }
      },
      "required": [
        "from_ms",
        "to_ms"
      ],
      "title": "MatchWindow",
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "description": "A team, player, or team-qualified player referenced by an assertion.",
      "properties": {
        "player_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Id"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "team_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team Id"
        }
      },
      "title": "Subject",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A requested metric comparison; truth is established by a registered query.",
  "properties": {
    "comparator": {
      "default": "eq",
      "enum": [
        "eq",
        "gte",
        "lte"
      ],
      "title": "Comparator",
      "type": "string"
    },
    "decimals": {
      "anyOf": [
        {
          "maximum": 6,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decimals"
    },
    "metric": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*\\.v[1-9][0-9]*$",
      "title": "Metric",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "unit": {
      "enum": [
        "count",
        "ratio",
        "synthetic_xg",
        "metres",
        "per_minute",
        "rating",
        "km_per_hour"
      ],
      "title": "Unit",
      "type": "string"
    },
    "value": {
      "minimum": 0,
      "title": "Value",
      "type": "number"
    },
    "window": {
      "$ref": "#/$defs/MatchWindow"
    }
  },
  "required": [
    "metric",
    "subject",
    "window",
    "value",
    "unit"
  ],
  "title": "MetricAssertion",
  "type": "object"
}
