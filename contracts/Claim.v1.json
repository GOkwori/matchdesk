{
  "$defs": {
    "EventFact": {
      "additionalProperties": false,
      "description": "A registered, checkable statement about specific events, not about an aggregate.\n\n``goal_scorer.v1``: goal ``event_id`` was scored by ``player_id``.\n``card.v1``: card ``event_id`` was shown to ``player_id``; the sentence's colour is checked\nagainst the recorded card.\n``substitution.v1``: substitution ``event_id`` took ``player_id`` off; the sentence must name\nthe recorded incoming player.\n``sequence_gap.v1``: ``event_id`` followed ``from_event_id`` by ``gap_seconds`` whole\nseconds (rounded half up), and, when ``from_tag`` is given, the earlier event carries\nthat tag (a corner is a tagged pass in schema 1.0).",
      "properties": {
        "event_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Event Id",
          "type": "string"
        },
        "from_event_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Event Id"
        },
        "from_tag": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Tag"
        },
        "gap_seconds": {
          "anyOf": [
            {
              "ge": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap Seconds"
        },
        "player_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Id"
        },
        "query": {
          "enum": [
            "goal_scorer.v1",
            "sequence_gap.v1",
            "card.v1",
            "substitution.v1"
          ],
          "title": "Query",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "query",
        "event_id"
      ],
      "title": "EventFact",
      "type": "object"
    },
    "MatchWindow": {
      "additionalProperties": false,
      "description": "A nonempty half-open [from_ms, to_ms) window of match clock time.\n\nWith a period, the window covers that period only. Without one (``None``), it covers\nboth periods: every event whose match clock falls in the window, whichever half it is\nin. That is how a \"whole match so far\" claim is expressed as a single assertion.",
      "properties": {
        "from_ms": {
          "minimum": 0,
          "title": "From Ms",
          "type": "integer"
        },
        "period": {
          "anyOf": [
            {
              "enum": [
                1,
                2
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "to_ms": {
          "minimum": 1,
          "title": "To Ms",
          "type": "integer"
        }
      },
      "required": [
        "from_ms",
        "to_ms"
      ],
      "title": "MatchWindow",
      "type": "object"
    },
    "MetricAssertion": {
      "additionalProperties": false,
      "description": "A requested metric comparison; truth is established by a registered query.",
      "properties": {
        "comparator": {
          "default": "eq",
          "enum": [
            "eq",
            "gte",
            "lte"
          ],
          "title": "Comparator",
          "type": "string"
        },
        "decimals": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decimals"
        },
        "metric": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*\\.v[1-9][0-9]*$",
          "title": "Metric",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "unit": {
          "enum": [
            "count",
            "ratio",
            "synthetic_xg",
            "metres",
            "per_minute",
            "rating",
            "km_per_hour",
            "kilometres"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "window": {
          "$ref": "#/$defs/MatchWindow"
        }
      },
      "required": [
        "metric",
        "subject",
        "window",
        "value",
        "unit"
      ],
      "title": "MetricAssertion",
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "description": "A team, player, or team-qualified player referenced by an assertion.",
      "properties": {
        "player_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Id"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "team_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team Id"
        }
      },
      "title": "Subject",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A narrative assertion with evidence references, not a verification certificate.",
  "properties": {
    "assertion": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetricAssertion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "claim_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Claim Id",
      "type": "string"
    },
    "evidence_event_ids": {
      "items": {
        "maxLength": 96,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "maxItems": 4096,
      "minItems": 1,
      "title": "Evidence Event Ids",
      "type": "array"
    },
    "fact": {
      "anyOf": [
        {
          "$ref": "#/$defs/EventFact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "enum": [
        "measured_stat",
        "event_fact",
        "tactical_inference"
      ],
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "text": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "claim_id",
    "text",
    "kind",
    "evidence_event_ids"
  ],
  "title": "Claim",
  "type": "object"
}
