{
  "$defs": {
    "ApprovalBinding": {
      "additionalProperties": false,
      "description": "Exact artefacts that a future producer approval must bind transactionally.\n\nHashing this record is not a signature. The service must establish the actor,\npreserve a server-side approval and compare all bindings at publication.",
      "properties": {
        "content_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "evidence_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "item_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Item Id",
          "type": "string"
        },
        "item_version": {
          "minimum": 1,
          "title": "Item Version",
          "type": "integer"
        },
        "language": {
          "enum": [
            "en",
            "es",
            "fr"
          ],
          "title": "Language",
          "type": "string"
        },
        "persona": {
          "enum": [
            "analyst",
            "casual_fan",
            "broadcast_caption"
          ],
          "title": "Persona",
          "type": "string"
        },
        "replay_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Replay Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "item_version",
        "replay_id",
        "content_digest",
        "evidence_digest",
        "language",
        "persona"
      ],
      "title": "ApprovalBinding",
      "type": "object"
    },
    "ClaimLinkedText": {
      "additionalProperties": false,
      "description": "An authored passage explicitly associated with an upstream claim ID.",
      "properties": {
        "claim_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Claim Id",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text"
      ],
      "title": "ClaimLinkedText",
      "type": "object"
    },
    "CommentaryPayload": {
      "additionalProperties": false,
      "description": "One short, ordered play-by-play or analysis commentary draft.",
      "properties": {
        "kind": {
          "const": "commentary",
          "default": "commentary",
          "title": "Kind",
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/ClaimLinkedText"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Lines",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "lines"
      ],
      "title": "CommentaryPayload",
      "type": "object"
    },
    "ExplainerPayload": {
      "additionalProperties": false,
      "description": "A headline and ordered explanatory points bound to claim references.",
      "properties": {
        "headline": {
          "$ref": "#/$defs/ClaimLinkedText"
        },
        "kind": {
          "const": "explainer",
          "default": "explainer",
          "title": "Kind",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/ClaimLinkedText"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Points",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "headline",
        "points"
      ],
      "title": "ExplainerPayload",
      "type": "object"
    },
    "FullTimeRecapPayload": {
      "additionalProperties": false,
      "description": "A two-period draft with claim-linked headline and ordered highlights.",
      "properties": {
        "headline": {
          "$ref": "#/$defs/ClaimLinkedText"
        },
        "highlights": {
          "items": {
            "$ref": "#/$defs/ClaimLinkedText"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Highlights",
          "type": "array"
        },
        "kind": {
          "const": "full_time_recap",
          "default": "full_time_recap",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "headline",
        "highlights"
      ],
      "title": "FullTimeRecapPayload",
      "type": "object"
    },
    "HalfTimeRecapPayload": {
      "additionalProperties": false,
      "description": "A first-half draft with claim-linked headline and ordered highlights.",
      "properties": {
        "headline": {
          "$ref": "#/$defs/ClaimLinkedText"
        },
        "highlights": {
          "items": {
            "$ref": "#/$defs/ClaimLinkedText"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Highlights",
          "type": "array"
        },
        "kind": {
          "const": "half_time_recap",
          "default": "half_time_recap",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "headline",
        "highlights"
      ],
      "title": "HalfTimeRecapPayload",
      "type": "object"
    },
    "MatchWindow": {
      "additionalProperties": false,
      "description": "A nonempty half-open [from_ms, to_ms) window within one match period.",
      "properties": {
        "from_ms": {
          "minimum": 0,
          "title": "From Ms",
          "type": "integer"
        },
        "period": {
          "enum": [
            1,
            2
          ],
          "title": "Period",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "to_ms": {
          "minimum": 1,
          "title": "To Ms",
          "type": "integer"
        }
      },
      "required": [
        "period",
        "from_ms",
        "to_ms"
      ],
      "title": "MatchWindow",
      "type": "object"
    },
    "MetricAssertion": {
      "additionalProperties": false,
      "description": "A requested metric comparison; truth is established by a registered query.",
      "properties": {
        "comparator": {
          "default": "eq",
          "enum": [
            "eq",
            "gte",
            "lte"
          ],
          "title": "Comparator",
          "type": "string"
        },
        "metric": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*\\.v[1-9][0-9]*$",
          "title": "Metric",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "unit": {
          "enum": [
            "count",
            "ratio",
            "synthetic_xg",
            "metres",
            "per_minute"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "window": {
          "$ref": "#/$defs/MatchWindow"
        }
      },
      "required": [
        "metric",
        "subject",
        "window",
        "value",
        "unit"
      ],
      "title": "MetricAssertion",
      "type": "object"
    },
    "OverlayMetric": {
      "additionalProperties": false,
      "description": "An overlay number that must be checked against its referenced metric claim.",
      "properties": {
        "assertion": {
          "$ref": "#/$defs/MetricAssertion"
        },
        "claim_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Claim Id",
          "type": "string"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "claim_id",
        "assertion"
      ],
      "title": "OverlayMetric",
      "type": "object"
    },
    "OverlayPayload": {
      "additionalProperties": false,
      "description": "Structured overlay JSON with claim-bound numbers, not display-string facts.",
      "properties": {
        "headline": {
          "$ref": "#/$defs/ClaimLinkedText"
        },
        "kind": {
          "const": "overlay",
          "default": "overlay",
          "title": "Kind",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/OverlayMetric"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "headline",
        "metrics"
      ],
      "title": "OverlayPayload",
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "description": "A team, player, or team-qualified player referenced by an assertion.",
      "properties": {
        "player_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Id"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "team_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team Id"
        }
      },
      "title": "Subject",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One session/replay-scoped draft with exact content and evidence references.\n\nThe producer-approved binding must use the canonical digest of the complete\npayload, including the versioned kind. This detects payload drift, but does not\nauthenticate a producer, prove claim truth or authorize actual publication.",
  "properties": {
    "binding": {
      "$ref": "#/$defs/ApprovalBinding"
    },
    "claim_ids": {
      "items": {
        "maxLength": 96,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "maxItems": 4096,
      "minItems": 1,
      "title": "Claim Ids",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "maxLength": 96,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "maxItems": 4096,
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "match_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Match Id",
      "type": "string"
    },
    "output_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Output Id",
      "type": "string"
    },
    "payload": {
      "discriminator": {
        "mapping": {
          "commentary": "#/$defs/CommentaryPayload",
          "explainer": "#/$defs/ExplainerPayload",
          "full_time_recap": "#/$defs/FullTimeRecapPayload",
          "half_time_recap": "#/$defs/HalfTimeRecapPayload",
          "overlay": "#/$defs/OverlayPayload"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CommentaryPayload"
        },
        {
          "$ref": "#/$defs/ExplainerPayload"
        },
        {
          "$ref": "#/$defs/OverlayPayload"
        },
        {
          "$ref": "#/$defs/HalfTimeRecapPayload"
        },
        {
          "$ref": "#/$defs/FullTimeRecapPayload"
        }
      ],
      "title": "Payload"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Session Id",
      "type": "string"
    },
    "windows": {
      "items": {
        "$ref": "#/$defs/MatchWindow"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Windows",
      "type": "array"
    }
  },
  "required": [
    "output_id",
    "session_id",
    "match_id",
    "binding",
    "windows",
    "evidence_ids",
    "claim_ids",
    "payload"
  ],
  "title": "BroadcastEnvelope",
  "type": "object"
}
